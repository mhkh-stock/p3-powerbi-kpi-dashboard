// P3 DAX measures — paste into Power BI Desktop (Modeling > New measure).
// Assumes tables fact_sales, dim_product, dim_region, dim_channel, dim_date
// with the relationships in dashboard/powerbi-build-guide.md.
// All measures are written against fact_sales; dimensions only filter.

Total Sales = SUM(fact_sales[sales_amount])

Total Profit = SUM(fact_sales[profit])

Profit Margin % = DIVIDE([Total Profit], [Total Sales])

Total Orders = DISTINCTCOUNT(fact_sales[order_id])

Total Units = SUM(fact_sales[quantity])

Average Order Value = DIVIDE([Total Sales], [Total Orders])

Sales Previous Month =
    CALCULATE([Total Sales], DATEADD(dim_date[month_date], -1, MONTH))
// NOTE: dim_date ships a real date column, month_date (first of each
// month, e.g. 2026-01-01) — set it to Date type on import (see the
// build guide, step 1) so DATEADD works with no extra setup.

Sales MoM Growth % =
    DIVIDE([Total Sales] - [Sales Previous Month], [Sales Previous Month])

Top Product Sales =
    MAXX(
        TOPN(1, VALUES(dim_product[product]),
            CALCULATE([Total Sales])),
        [Total Sales]
    )
